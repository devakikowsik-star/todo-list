<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title || 'Sports Scheduler' %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <!-- FontAwesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
  <!-- Navigation Bar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-3">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-uppercase tracking-wider" href="<%= user ? '/dashboard' : '/' %>">
        <span class="brand-icon bg-primary text-white rounded-3 d-inline-flex align-items-center justify-content-center p-2">
          <i class="fa-solid fa-volleyball fs-5"></i>
        </span>
        <span class="fs-4">Sports<span class="text-primary">Scheduler</span></span>
      </a>
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
          <% if (user) { %>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/dashboard' ? 'active text-primary fw-semibold' : '' %>" href="/dashboard">
                <i class="fa-solid fa-gauge-high me-1"></i> Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/sessions/available' ? 'active text-primary fw-semibold' : '' %>" href="/sessions/available">
                <i class="fa-regular fa-calendar-check me-1"></i> Available Sessions
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/sessions/joined' ? 'active text-primary fw-semibold' : '' %>" href="/sessions/joined">
                <i class="fa-solid fa-users me-1"></i> Joined Sessions
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/sessions/my' ? 'active text-primary fw-semibold' : '' %>" href="/sessions/my">
                <i class="fa-regular fa-folder-open me-1"></i> My Sessions
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath.startsWith('/sports') ? 'active text-primary fw-semibold' : '' %>" href="/sports">
                <i class="fa-solid fa-medal me-1"></i> Sports
              </a>
            </li>
            <% if (user.role === 'admin') { %>
              <li class="nav-item">
                <a class="nav-link <%= currentPath.startsWith('/reports') ? 'active text-warning fw-semibold' : '' %>" href="/reports">
                  <i class="fa-solid fa-chart-line me-1 text-warning"></i> Reports
                </a>
              </li>
            <% } %>
          <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/#features"><i class="fa-solid fa-star me-1"></i> Features</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/#about"><i class="fa-solid fa-circle-info me-1"></i> About</a>
            </li>
          <% } %>
        </ul>

        <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
          <% if (user) { %>
            <a href="/sessions/new" class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm d-flex align-items-center gap-2">
              <i class="fa-solid fa-plus"></i>
              <span>Create Session</span>
            </a>
            <div class="dropdown">
              <button class="btn btn-outline-light btn-sm dropdown-toggle rounded-pill px-3 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-regular fa-circle-user fs-6"></i>
                <span class="fw-semibold"><%= user.firstName %></span>
                <span class="badge <%= user.role === 'admin' ? 'bg-warning text-dark' : 'bg-secondary' %> rounded-pill text-uppercase fs-9">
                  <%= user.role %>
                </span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><h6 class="dropdown-header"><%= user.email %></h6></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/dashboard"><i class="fa-solid fa-house me-2 text-muted"></i>Dashboard</a></li>
                <li><a class="dropdown-item" href="/sessions/my"><i class="fa-regular fa-calendar-days me-2 text-muted"></i>My Sessions</a></li>
                <% if (user.role === 'admin') { %>
                  <li><a class="dropdown-item" href="/sports"><i class="fa-solid fa-medal me-2 text-muted"></i>Manage Sports</a></li>
                  <li><a class="dropdown-item" href="/reports"><i class="fa-solid fa-chart-pie me-2 text-muted"></i>Reports & Analytics</a></li>
                <% } %>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <a class="dropdown-item text-danger fw-semibold" href="/signout">
                    <i class="fa-solid fa-right-from-bracket me-2"></i>Sign Out
                  </a>
                </li>
              </ul>
            </div>
          <% } else { %>
            <a href="/login" class="btn btn-outline-light btn-sm px-3 rounded-pill fw-semibold">
              <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Log In
            </a>
            <a href="/signup" class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm">
              <i class="fa-solid fa-user-plus me-1"></i> Sign Up
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Notification Flash Banners -->
  <div class="container mt-3">
    <%- include('notifications') %>
  </div>

  <!-- Main Content Body -->
  <main class="flex-grow-1 py-4">
    <div class="container">
