<%- include('../header') %>

<div class="row justify-content-center py-3">
  <div class="col-lg-8">
    <!-- Cancellation Banner -->
    <% if (session.isCancelled) { %>
      <div class="alert alert-danger shadow-sm rounded-4 p-4 mb-4 border-danger d-flex align-items-start gap-3">
        <div class="p-2 bg-danger text-white rounded-circle">
          <i class="fa-solid fa-ban fs-4"></i>
        </div>
        <div>
          <h5 class="fw-bold text-danger mb-1">This Session Has Been Cancelled</h5>
          <p class="mb-2 text-dark">The host cancelled this scheduled match.</p>
          <div class="bg-white p-3 rounded-3 border border-danger-subtle">
            <span class="fw-bold text-danger">Cancellation Reason:</span>
            <span class="text-dark"><%= session.cancellationReason || 'No reason specified by host' %></span>
          </div>
        </div>
      </div>
    <% } %>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
      <!-- Session Header -->
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4 pb-3 border-bottom">
        <div>
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold fs-6">
              <i class="fa-solid fa-medal me-1"></i> <%= session.sport ? session.sport.name : 'Sport' %>
            </span>
            <% if (session.isCancelled) { %>
              <span class="badge bg-danger rounded-pill px-3 py-2 fw-semibold">Cancelled</span>
            <% } else if (isPast) { %>
              <span class="badge bg-secondary rounded-pill px-3 py-2 fw-semibold">Completed</span>
            <% } else { %>
              <span class="badge bg-success rounded-pill px-3 py-2 fw-semibold">
                <%= remainingSlots %> Open Slots Remaining
              </span>
            <% } %>
          </div>
          <h2 class="fw-bold text-dark mb-0"><%= session.venue %></h2>
        </div>

        <div class="d-flex gap-2">
          <% if (!session.isCancelled && !isPast) { %>
            <% if (isCreator || isAdmin) { %>
              <a href="/sessions/<%= session.id %>/cancel" class="btn btn-outline-danger rounded-pill px-3 fw-semibold">
                <i class="fa-solid fa-ban me-1"></i> Cancel Session
              </a>
            <% } %>
          <% } %>
        </div>
      </div>

      <!-- Session Logistics Details Grid -->
      <div class="row g-3 mb-4">
        <div class="col-sm-6">
          <div class="p-3 bg-light rounded-4 h-100">
            <div class="text-muted small mb-1"><i class="fa-regular fa-calendar text-primary me-1"></i> Scheduled Date</div>
            <div class="fw-bold text-dark fs-5">
              <%= new Date(session.dateTime).toLocaleDateString([], { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %>
            </div>
          </div>
        </div>
        <div class="col-sm-6">
          <div class="p-3 bg-light rounded-4 h-100">
            <div class="text-muted small mb-1"><i class="fa-regular fa-clock text-info me-1"></i> Match Time</div>
            <div class="fw-bold text-dark fs-5">
              <%= new Date(session.dateTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
            </div>
          </div>
        </div>
        <div class="col-sm-6">
          <div class="p-3 bg-light rounded-4 h-100">
            <div class="text-muted small mb-1"><i class="fa-regular fa-user text-secondary me-1"></i> Session Host</div>
            <div class="fw-bold text-dark fs-6">
              <%= session.creator ? (session.creator.firstName + ' ' + (session.creator.lastName || '')) : 'Platform Host' %>
              <% if (isCreator) { %>
                <span class="badge bg-primary-subtle text-primary rounded-pill ms-1">You</span>
              <% } %>
            </div>
          </div>
        </div>
        <div class="col-sm-6">
          <div class="p-3 bg-light rounded-4 h-100">
            <div class="text-muted small mb-1"><i class="fa-solid fa-users text-success me-1"></i> Player Slots Capacity</div>
            <div class="fw-bold text-dark fs-6">
              <%= session.participants ? session.participants.length : 0 %> joined / <%= session.additionalPlayersNeeded %> needed
            </div>
          </div>
        </div>
      </div>

      <!-- Rosters & Confirmed Players -->
      <div class="mb-4">
        <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
          <i class="fa-solid fa-clipboard-user text-primary"></i> Confirmed Players Roster
        </h5>

        <!-- Host Card -->
        <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 mb-2">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-circle bg-primary text-white p-2 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
              <i class="fa-solid fa-crown fs-6"></i>
            </div>
            <div>
              <div class="fw-bold text-dark"><%= session.creator ? (session.creator.firstName + ' ' + (session.creator.lastName || '')) : 'Host' %></div>
              <div class="text-muted extra-small">Session Organizer / Host</div>
            </div>
          </div>
          <span class="badge bg-primary text-white rounded-pill px-3 py-1">Organizer</span>
        </div>

        <!-- Pre-existing Players List -->
        <% if (session.existingPlayers) { %>
          <div class="p-3 bg-light-subtle border rounded-3 mb-2">
            <div class="fw-semibold text-dark small mb-1"><i class="fa-solid fa-users-line text-muted me-1"></i> Additional Teammates Already Coming:</div>
            <div class="text-muted small"><%= session.existingPlayers %></div>
          </div>
        <% } %>

        <!-- Joined Platform Users -->
        <% if (session.participants && session.participants.length > 0) { %>
          <div class="vstack gap-2 mt-3">
            <div class="fw-semibold text-dark small mb-1">Platform Players Joined (<%= session.participants.length %>):</div>
            <% session.participants.forEach(function(p, idx) { %>
              <div class="d-flex align-items-center justify-content-between p-2 px-3 border rounded-3 bg-white">
                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-secondary rounded-pill me-1">#<%= idx + 1 %></span>
                  <i class="fa-solid fa-user-check text-success"></i>
                  <span class="fw-medium text-dark"><%= p.user ? (p.user.firstName + ' ' + (p.user.lastName || '')) : 'Player' %></span>
                  <% if (p.userId === user.id) { %>
                    <span class="badge bg-primary-subtle text-primary rounded-pill">You</span>
                  <% } %>
                </div>
                <span class="text-muted extra-small">RSVP Confirmed</span>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="p-3 text-center text-muted border rounded-3 bg-white mt-2 small">
            No platform players have joined this session yet.
          </div>
        <% } %>
      </div>

      <!-- Participation CTA Bar -->
      <div class="pt-4 border-top">
        <% if (!session.isCancelled && !isPast) { %>
          <% if (isCreator) { %>
            <div class="d-flex align-items-center justify-content-between p-3 bg-primary-subtle rounded-4 text-primary">
              <span class="fw-semibold"><i class="fa-solid fa-circle-info me-2"></i>You are hosting this session.</span>
              <a href="/sessions/<%= session.id %>/cancel" class="btn btn-sm btn-outline-danger rounded-pill fw-semibold">
                Cancel Match
              </a>
            </div>
          <% } else if (hasJoined) { %>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 bg-success-subtle rounded-4 text-success">
              <span class="fw-semibold"><i class="fa-solid fa-circle-check me-2"></i>You have reserved a spot in this session!</span>
              <form action="/sessions/<%= session.id %>/leave" method="POST" onsubmit="return confirm('Are you sure you want to leave this session?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill fw-semibold px-3">
                  <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Leave Session
                </button>
              </form>
            </div>
          <% } else if (remainingSlots > 0) { %>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 bg-light rounded-4">
              <div>
                <span class="fw-bold text-dark fs-6 d-block">Ready to hit the field?</span>
                <span class="text-muted small"><%= remainingSlots %> slots open right now.</span>
              </div>
              <form action="/sessions/<%= session.id %>/join" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm">
                  <i class="fa-solid fa-user-plus me-1"></i> Join This Session
                </button>
              </form>
            </div>
          <% } else { %>
            <div class="alert alert-secondary text-center mb-0 rounded-4">
              <i class="fa-solid fa-lock me-1"></i> This session is fully booked. All slots have been filled.
            </div>
          <% } %>
        <% } else if (session.isCancelled) { %>
          <div class="alert alert-danger text-center mb-0 rounded-4">
            <i class="fa-solid fa-ban me-1"></i> This session has been cancelled and cannot be joined.
          </div>
        <% } else { %>
          <div class="alert alert-secondary text-center mb-0 rounded-4">
            <i class="fa-solid fa-clock-rotate-left me-1"></i> This session has already concluded.
          </div>
        <% } %>
      </div>

      <div class="mt-4 text-center">
        <a href="/sessions/available" class="btn btn-link text-decoration-none text-muted small">
          &larr; Back to Available Sessions
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../footer') %>
