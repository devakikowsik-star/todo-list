<%- include('../header') %>

<div class="row justify-content-center py-4">
  <div class="col-md-6 col-lg-5">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
      <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
        <div>
          <span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill fw-semibold mb-1">
            Admin Action
          </span>
          <h4 class="fw-bold mb-0">Edit Sport</h4>
        </div>
        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
          <i class="fa-solid fa-pen-to-square fs-4"></i>
        </div>
      </div>

      <form action="/sports/<%= sport.id %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-4">
          <label for="name" class="form-label fw-semibold">Sport Name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="name" name="name" value="<%= sport.name %>" required autofocus>
          <div class="form-text">Update the sport's public display name.</div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm flex-grow-1">
            <i class="fa-solid fa-check me-1"></i> Save Changes
          </button>
          <a href="/sports" class="btn btn-outline-secondary rounded-pill px-4">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../footer') %>
